# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_WEB3FORMS_KEY: Optional free Web3Forms access key for contact form delivery.
# If omitted, the contact form gracefully falls back to a pre-filled mailto: link.
NEXT_PUBLIC_WEB3FORMS_KEY=""

# NEXT_PUBLIC_OWNER_MASTER_KEY: Optional master license key for unlocking the Pro DevSecOps Suite
# in /tools/generator for your own portfolio workflows.
NEXT_PUBLIC_OWNER_MASTER_KEY=""

# ADMIN_PASSWORD: Server-only password protecting the /admin panel via /api/admin/auth.
# Never prefix with NEXT_PUBLIC_. Set this in your server environment / Secrets panel.
ADMIN_PASSWORD=""

# GITHUB_REPOSITORY: Optional "owner/repo" slug (e.g. Shivam-Infra-Labs/devops-portfolio)
# queried server-side for live GitHub Actions CI health in the Hero section.
GITHUB_REPOSITORY=""


